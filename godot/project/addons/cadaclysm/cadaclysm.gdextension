; cadaclysm for Godot: read CAD files and build exact solids.
; Each platform's extension sits in bin/<platform>/ with the cadaclysm library (its full
; flavour) beside it; [dependencies] copies it next to an exported game's executable, where
; the extension finds it.
[configuration]
entry_symbol = "gdext_rust_init"
compatibility_minimum = 4.4
reloadable = false

[libraries]
windows.x86_64 = "res://addons/cadaclysm/bin/windows-x64/cadaclysm_godot.dll"
linux.x86_64 = "res://addons/cadaclysm/bin/linux-x64/libcadaclysm_godot.so"
linux.arm64 = "res://addons/cadaclysm/bin/linux-arm64/libcadaclysm_godot.so"
macos = "res://addons/cadaclysm/bin/macos-universal/libcadaclysm_godot.dylib"

[dependencies]
windows.x86_64 = { "res://addons/cadaclysm/bin/windows-x64/cadaclysm.dll": "" }
linux.x86_64 = { "res://addons/cadaclysm/bin/linux-x64/libcadaclysm.so": "" }
linux.arm64 = { "res://addons/cadaclysm/bin/linux-arm64/libcadaclysm.so": "" }
macos = { "res://addons/cadaclysm/bin/macos-universal/libcadaclysm.dylib": "" }
