<Project Sdk="Microsoft.NET.Sdk">
  <!-- The whole binding is ../Cad.cs; this project proves it loads and runs against
       the built library, and is what the public SDK's C# sample is. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>smoke</AssemblyName>
    <RootNamespace>Cadaclysm</RootNamespace>
    <InvariantGlobalization>true</InvariantGlobalization>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../Cad.cs" />
  </ItemGroup>
</Project>
