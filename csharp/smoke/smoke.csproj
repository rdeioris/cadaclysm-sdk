<Project Sdk="Microsoft.NET.Sdk">
  <!-- The whole binding is ../Cad.cs (the reader) and ../Blacksmith.cs (the kernel); this
       project proves both load and run against the built libraries, and is what the public
       SDK's C# sample is. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>smoke</AssemblyName>
    <RootNamespace>Cadaclysm</RootNamespace>
    <InvariantGlobalization>true</InvariantGlobalization>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../Cad.cs" />
    <Compile Include="../Blacksmith.cs" />
  </ItemGroup>
</Project>
