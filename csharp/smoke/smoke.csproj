<Project Sdk="Microsoft.NET.Sdk">
  <!-- The whole binding is ../Cad.cs (the reader), ../Blacksmith.cs (the kernel) and
       ../View.cs (drawing): the three refer to each other and compile together. This project
       proves they load and run against the built libraries, and is what the public SDK's C#
       sample is (it ships in the SDK). -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>smoke</AssemblyName>
    <RootNamespace>Cadaclysm</RootNamespace>
    <InvariantGlobalization>true</InvariantGlobalization>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- Optimised in every configuration, and no tiering: the smoke's GC-pressure check
         (temporaries joined while another thread collects) only bites when the JIT ends an
         operand's lifetime at its last use, which debuggable and tier-0 code never do. -->
    <Optimize>true</Optimize>
    <TieredCompilation>false</TieredCompilation>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../Cad.cs" />
    <Compile Include="../Blacksmith.cs" />
    <Compile Include="../View.cs" />
  </ItemGroup>
</Project>
